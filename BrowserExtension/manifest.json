{
  "manifest_version": 3,
  "name": "SwiftGrab Downloader",
  "version": "1.0.0",
  "description": "Send download links to SwiftGrab desktop app with one click.",
  "permissions": ["nativeMessaging", "contextMenus", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "SwiftGrab",
    "default_popup": "popup.html"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
