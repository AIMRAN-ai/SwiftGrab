<mah:MetroWindow
    x:Class="SwiftGrab.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:SwiftGrab.ViewModels"
    mc:Ignorable="d"
    Title="SwiftGrab"
    Height="680" Width="1100"
    WindowStartupLocation="CenterScreen"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    ResizeMode="CanResizeWithGrip">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </mah:MetroWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="0"
                   Text="⚡ SwiftGrab"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                   Margin="0,0,0,12"/>

        <!-- ── Add Download Bar ───────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Paste URL, magnet link, or YouTube link…"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,6,0"
                     VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     Text="{Binding SavePath}"
                     Width="200"
                     md:HintAssist.Hint="Save folder"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,4,0"
                     VerticalAlignment="Center"/>

            <Button Grid.Column="2"
                    Command="{Binding BrowseSavePathCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="📁"
                    Margin="0,0,6,0"
                    ToolTip="Browse save folder"/>

            <Button Grid.Column="3"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="⬇ Add"
                    ToolTip="Start download"/>
        </Grid>

        <!-- ── Download List ─────────────────────────────────────────── -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Downloads}"
                  SelectedItem="{Binding SelectedDownload}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserResizeColumns="True"
                  md:DataGridAssist.CellPadding="8 4 8 4"
                  md:DataGridAssist.ColumnHeaderPadding="8 6 8 6">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"       Binding="{Binding DisplayName}" Width="3*"/>
                <DataGridTextColumn Header="Status"     Binding="{Binding StatusText}"  Width="90"/>
                <DataGridTextColumn Header="Progress"   Binding="{Binding ProgressText}" Width="70"/>
                <DataGridTemplateColumn Header="Progress Bar" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ProgressBar Value="{Binding Item.ProgressPercent}"
                                         Maximum="100"
                                         Height="8"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Speed"      Binding="{Binding SpeedText}"   Width="90"/>
                <DataGridTextColumn Header="ETA"        Binding="{Binding EtaText}"     Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Toolbar + Status Bar ──────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding PauseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="⏸ Pause"
                    Margin="0,0,6,0"/>

            <Button Grid.Column="1"
                    Command="{Binding ResumeCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="▶ Resume"
                    Margin="0,0,6,0"/>

            <Button Grid.Column="2"
                    Command="{Binding RemoveCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="🗑 Remove"/>

            <TextBlock Grid.Column="3"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                       FontSize="12"/>
        </Grid>
    </Grid>
</mah:MetroWindow>
